// Kwidus21 — production data model.
// Money is ALWAYS stored as integer minor units (e.g. cents) + an ISO currency code.
// Never floating point.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  phone         String?
  marketingOptIn Boolean   @default(false)
  adminNotes    String?
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  addresses      Address[]
  carts          Cart[]
  wishlists      Wishlist[]
  orders         Order[]
  reviews        Review[]
  returnRequests ReturnRequest[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  recentlyViewed RecentlyViewed[]
  permissions    UserPermission[]
  couponUses     CouponRedemption[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Fine-grained permission grants layered on top of the coarse UserRole.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "product:write"
  description String
  createdAt   DateTime @default(now())

  users UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId       String
  permissionId String
  grantedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id           String      @id @default(cuid())
  userId       String?
  type         AddressType @default(SHIPPING)
  fullName     String
  company      String?
  line1        String
  line2        String?
  city         String
  region       String
  postalCode   String
  countryCode  String      @db.Char(2)
  phone        String?
  isDefault    Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user            User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders  Order[] @relation("OrderShippingAddress")
  billingOrders   Order[] @relation("OrderBillingAddress")

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  parentId        String?
  position         Int      @default(0)
  imageUrl        String?
  imageAlt        String?
  iconKey         String?
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]
  attributeDefs AttributeDefinition[]

  @@index([parentId])
  @@index([isActive])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "categories_name_trgm_idx")
  @@map("categories")
}

model Brand {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  logoUrl         String?
  websiteUrl      String?
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products Product[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "brands_name_trgm_idx")
  @@map("brands")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model TaxClass {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  /// Rate in basis points (e.g. 2000 = 20.00%).
  rateBps   Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("tax_classes")
}

model Product {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String?
  description      String
  brandId          String?
  taxClassId       String?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  publishedAt      DateTime?
  tags             String[]      @default([])
  /// Denormalised review aggregates kept in sync by the review service.
  ratingAverageBps Int           @default(0)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  metaTitle        String?
  metaDescription  String?
  model3dUrl       String?
  videoUrl         String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxClass   TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  categories ProductCategory[]
  variants   ProductVariant[]
  options    ProductOption[]
  media      ProductMedia[]
  attributes ProductAttribute[]
  reviews    Review[]
  wishlistItems WishlistItem[]
  recentlyViewed RecentlyViewed[]
  relatedFrom ProductRelation[] @relation("RelationSource")
  relatedTo   ProductRelation[] @relation("RelationTarget")

  @@index([status, publishedAt])
  @@index([brandId])
  @@index([isFeatured])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "products_title_trgm_idx")
  @@index([tags], type: Gin, name: "products_tags_idx")
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

enum RelationKind {
  RELATED
  CROSS_SELL
  UPSELL
}

model ProductRelation {
  id        String       @id @default(cuid())
  sourceId  String
  targetId  String
  kind      RelationKind
  position  Int          @default(0)

  source Product @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Product @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, kind])
  @@map("product_relations")
}

/// An option axis for a product, e.g. "Colour" or "Size".
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)

  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id        String  @id @default(cuid())
  optionId  String
  value     String
  /// Optional hex swatch for colour-style options.
  swatchHex String?
  position  Int     @default(0)

  option    ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  selections VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  sku            String    @unique
  barcode        String?
  title          String
  /// Regular price in minor units.
  priceCents     Int
  /// Optional active sale price in minor units; must be lower than priceCents.
  salePriceCents Int?
  /// Internal cost price — never exposed to the storefront.
  costPriceCents Int?
  currency       String    @db.Char(3)
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  position       Int       @default(0)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  lowStockThreshold Int    @default(5)
  allowBackorder Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  inventory    InventoryItem[]
  media        ProductMedia[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  wishlistItems WishlistItem[]

  @@index([productId])
  @@index([isActive])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, name: "variants_sku_trgm_idx")
  @@map("product_variants")
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

enum MediaKind {
  IMAGE
  VIDEO
  MODEL_3D
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  variantId String?
  kind      MediaKind @default(IMAGE)
  url       String
  alt       String
  width     Int?
  height    Int?
  position  Int       @default(0)
  /// Attribution / licence note for demo or stock imagery.
  credit    String?
  createdAt DateTime  @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_media")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

/// Admin-defined attribute schema, optionally scoped to a category.
/// This is what lets new product types exist without code changes.
model AttributeDefinition {
  id           String        @id @default(cuid())
  key          String        @unique
  label        String
  type         AttributeType @default(TEXT)
  unit         String?
  options      String[]      @default([])
  categoryId   String?
  isFilterable Boolean       @default(false)
  position     Int           @default(0)
  createdAt    DateTime      @default(now())

  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  values   ProductAttribute[]

  @@map("attribute_definitions")
}

model ProductAttribute {
  id           String  @id @default(cuid())
  productId    String
  definitionId String
  value        String

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productId, definitionId])
  @@index([definitionId, value])
  @@map("product_attributes")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  countryCode String   @db.Char(2)
  city        String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  items InventoryItem[]

  @@map("warehouses")
}

model InventoryItem {
  id          String   @id @default(cuid())
  variantId   String
  warehouseId String
  /// Physical units on hand.
  onHand      Int      @default(0)
  /// Units reserved for in-flight orders. available = onHand - reserved.
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@map("inventory_items")
}

enum InventoryReason {
  RESTOCK
  SALE
  RESERVATION
  RELEASE
  RETURN
  DAMAGE
  CORRECTION
  INITIAL
}

model InventoryTransaction {
  id              String          @id @default(cuid())
  inventoryItemId String
  /// Signed change applied to onHand.
  onHandDelta     Int             @default(0)
  /// Signed change applied to reserved.
  reservedDelta   Int             @default(0)
  reason          InventoryReason
  note            String?
  orderId         String?
  actorId         String?
  createdAt       DateTime        @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([orderId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Cart & wishlist
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  /// Anonymous cart token stored in an HttpOnly cookie.
  token      String     @unique
  status     CartStatus @default(ACTIVE)
  currency   String     @db.Char(3)
  couponId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([userId])
  @@index([status, updatedAt])
  @@map("carts")
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  variantId   String
  quantity    Int
  savedForLater Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Saved items")
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@unique([userId, name])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  /// Anonymous visitor token, mirrors the cart token cookie.
  token     String?
  productId String
  viewedAt  DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([token, productId])
  @@index([viewedAt])
  @@map("recently_viewed")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  description        String?
  discountType       DiscountType
  /// Percentage in basis points when PERCENTAGE, minor units when FIXED_AMOUNT.
  discountValue      Int
  currency           String?      @db.Char(3)
  minSubtotalCents   Int?
  maxDiscountCents   Int?
  usageLimit         Int?
  usageLimitPerUser  Int?
  timesUsed          Int          @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  restrictions CouponRestriction[]
  redemptions  CouponRedemption[]
  carts        Cart[]
  orders       Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

enum CouponScope {
  PRODUCT
  CATEGORY
  BRAND
}

model CouponRestriction {
  id        String      @id @default(cuid())
  couponId  String
  scope     CouponScope
  targetId  String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, scope, targetId])
  @@map("coupon_restrictions")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String?  @unique
  amountCents Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// Automatic (codeless) promotions, e.g. "20% off Beauty this week".
model Promotion {
  id            String       @id @default(cuid())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Int
  scope         CouponScope?
  targetId      String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  priority      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Shipping & tax
// ---------------------------------------------------------------------------

model ShippingZone {
  id           String   @id @default(cuid())
  name         String
  /// ISO-3166 alpha-2 country codes covered by this zone.
  countryCodes String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  methods ShippingMethod[]

  @@map("shipping_zones")
}

model ShippingMethod {
  id                String   @id @default(cuid())
  zoneId            String
  name              String
  code              String   @unique
  description       String?
  priceCents        Int
  currency          String   @db.Char(3)
  /// Order subtotal at or above which this method becomes free. Null = never.
  freeOverCents     Int?
  minDeliveryDays   Int
  maxDeliveryDays   Int
  isActive          Boolean  @default(true)
  position          Int      @default(0)

  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([zoneId])
  @@map("shipping_methods")
}

model TaxConfiguration {
  id           String   @id @default(cuid())
  countryCode  String   @db.Char(2)
  region       String?
  taxClassCode String
  rateBps      Int
  /// When true, displayed prices already include this tax.
  isInclusive  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([countryCode, region, taxClassCode])
  @@map("tax_configurations")
}

// ---------------------------------------------------------------------------
// Orders, payments, fulfilment
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String
  status            OrderStatus @default(PENDING_PAYMENT)
  currency          String      @db.Char(3)
  email             String

  subtotalCents     Int
  discountCents     Int         @default(0)
  shippingCents     Int         @default(0)
  taxCents          Int         @default(0)
  totalCents        Int
  refundedCents     Int         @default(0)

  couponId          String?
  couponCode        String?
  shippingAddressId String?
  billingAddressId  String?
  shippingMethodId  String?
  shippingMethodName String?
  customerNote      String?
  adminNote         String?

  placedAt          DateTime?
  paidAt            DateTime?
  processingAt      DateTime?
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  returnedAt        DateTime?
  refundedAt        DateTime?

  /// Guards against inventory being released or captured twice.
  inventoryCommitted Boolean    @default(false)
  inventoryReleased  Boolean    @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  coupon          Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingAddress Address?        @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?        @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingMethod  ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  payments       Payment[]
  refunds        Refund[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]
  statusHistory  OrderStatusEvent[]
  inventoryTxns  InventoryTransaction[]
  couponRedemption CouponRedemption?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  variantId      String?
  /// Immutable snapshot of what was bought, independent of later catalog edits.
  productTitle   String
  variantTitle   String
  sku            String
  imageUrl       String?
  brandName      String?
  quantity       Int
  unitPriceCents Int
  discountCents  Int     @default(0)
  taxCents       Int     @default(0)
  totalCents     Int
  refundedQuantity Int   @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       String        @default("stripe")
  /// Provider-side identifier (e.g. Stripe PaymentIntent id).
  providerRef    String        @unique
  /// Client secret is never stored; only non-sensitive references are.
  status         PaymentStatus @default(REQUIRES_PAYMENT)
  amountCents    Int
  currency       String        @db.Char(3)
  refundedCents  Int           @default(0)
  methodBrand    String?
  methodLast4    String?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String?
  /// Provider event id — unique so replayed webhooks are idempotent.
  providerEventId String @unique
  type        String
  payload     Json
  handledAt   DateTime?
  createdAt   DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  paymentId   String?
  providerRef String?      @unique
  amountCents Int
  currency    String       @db.Char(3)
  reason      String?
  status      RefundStatus @default(PENDING)
  actorId     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String
  trackingNumber String?
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events TrackingEvent[]

  @@index([orderId])
  @@map("shipments")
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("tracking_events")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
  CANCELLED
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  status      ReturnStatus @default(REQUESTED)
  reason      String
  comment     String?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@map("return_request_items")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id                String       @id @default(cuid())
  productId         String
  userId            String
  rating            Int
  title             String?
  body              String
  status            ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean     @default(false)
  helpfulCount      Int          @default(0)
  moderationNote    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   ReviewMedia[]

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model ReviewMedia {
  id       String @id @default(cuid())
  reviewId String
  url      String
  alt      String?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_media")
}

// ---------------------------------------------------------------------------
// Content, settings, operations
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum HomepageSectionKind {
  HERO
  CATEGORY_GRID
  PRODUCT_CAROUSEL
  EDITORIAL
  BANNER
  SHOWCASE_3D
  BENEFITS
  NEWSLETTER
}

model HomepageSection {
  id        String              @id @default(cuid())
  kind      HomepageSectionKind
  title     String?
  subtitle  String?
  position  Int                 @default(0)
  isActive  Boolean             @default(true)
  /// Kind-specific configuration validated by Zod at the edge of the app.
  config    Json                @default("{}")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([isActive, position])
  @@map("homepage_sections")
}

enum BannerPlacement {
  ANNOUNCEMENT
  HOMEPAGE_HERO
  CATEGORY_TOP
  CART_DRAWER
}

model Banner {
  id         String          @id @default(cuid())
  placement  BannerPlacement
  headline   String
  subtext    String?
  ctaLabel   String?
  ctaHref    String?
  imageUrl   String?
  imageAlt   String?
  theme      String          @default("default")
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean         @default(true)
  position   Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([placement, isActive])
  @@map("banners")
}

model NavigationMenu {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NavigationItem[]

  @@map("navigation_menus")
}

model NavigationItem {
  id       String  @id @default(cuid())
  menuId   String
  parentId String?
  label    String
  href     String
  position Int     @default(0)
  isFeatured Boolean @default(false)
  imageUrl String?

  menu     NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem?  @relation("NavItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavItemTree")

  @@index([menuId, position])
  @@map("navigation_items")
}

model SearchSynonym {
  id        String   @id @default(cuid())
  term      String   @unique
  synonyms  String[]
  createdAt DateTime @default(now())

  @@map("search_synonyms")
}

model SearchQueryLog {
  id        String   @id @default(cuid())
  query     String
  results   Int
  userId    String?
  createdAt DateTime @default(now())

  @@index([query])
  @@map("search_query_logs")
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  /// Redacted diff/metadata. Never contains secrets or payment credentials.
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  template   String
  subject    String
  providerRef String?
  status     String
  error      String?
  createdAt  DateTime @default(now())

  @@index([to, createdAt])
  @@map("email_logs")
}
