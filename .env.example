# ---------------------------------------------------------------------------
# Kiip Mall — environment variables. Copy to .env and fill in.
# NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# Database (PostgreSQL 14+)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Direct (non-pooled) connection used by migrations when the app runs behind a pooler.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth providers (leave blank to disable)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments
# "mock"   — deterministic local provider for development and tests (no network)
# "stripe" — production-grade provider; requires the keys below
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Transactional email (Resend). Blank API key => emails are logged, not sent.
RESEND_API_KEY=""
EMAIL_FROM="Kiip Mall <no-reply@example.com>"

# Rate limiting — optional Upstash Redis REST endpoint for multi-instance limits.
# Blank => in-process limiter (single instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Media storage — S3-compatible object storage for admin uploads.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Observability (optional)
SENTRY_DSN=""
LOG_LEVEL="info"

# Seed data — the demo admin password is read from here so no credential is
# ever hard-coded in the repository. Required when running `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@kiipmall.test"
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_EMAIL="customer@kiipmall.test"
SEED_CUSTOMER_PASSWORD=""

# End-to-end testing only: raises authentication rate limits so the suite can
# sign in repeatedly. The application refuses to boot with this enabled in
# production.
E2E_RELAX_AUTH_RATE_LIMIT="false"
